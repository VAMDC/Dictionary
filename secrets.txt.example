# Copy this file to secrets.txt next to settings.py and fill in a real key:
#
#     cp secrets.txt.example secrets.txt
#     uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#     chmod 600 secrets.txt
#
# secrets.txt is gitignored and must stay that way. The app refuses to start
# without a secret key unless VAMDC_DICT_DEBUG=1. Anything set in the real
# environment takes precedence over this file.

VAMDC_DICT_SECRET_KEY=put-a-freshly-generated-50-character-key-here

# Optional:
# VAMDC_DICT_DEBUG=1
# VAMDC_DICT_HOSTS=dictionary.vamdc.eu
# VAMDC_DICT_ORIGINS=https://dictionary.vamdc.eu
